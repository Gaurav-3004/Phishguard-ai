# PhishGuard AI - backend configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- AI provider (optional) ---------------------------------------
# If AI_PROVIDER is left as "none", PhishGuard AI runs entirely on the
# local rule-based detection engine (detection_engine.py). Everything
# in the "must work" list functions with no AI key at all.
AI_PROVIDER=none            # one of: none | gemini | openai
AI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# --- Server ----------------------------------------------------------
FLASK_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# --- Database ----------------------------------------------------------
DATABASE_PATH=./phishguard.db

# --- Rate limiting -----------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
